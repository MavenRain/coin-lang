-- Sample domain. Replace it with your design. See domain/README.md.
-- Each family, constructor, field and def name here becomes a core name
-- (rule R4). Only this file can declare a family (rule R1).
family Color := red | green | blue
family Item := makeItem (itemColor : Color) (itemPrice : Nat) (itemCount : Nat)
family Stack := bottom | push (top : Nat) (rest : Stack)
-- An indexed family (former F15): `Lot 3` is a lot of size 3.
family Lot (size : Nat) := makeLot (lotPrice : Nat)
-- The circle, a higher inductive family (S4a, R1 (a)). The path
-- constructor loop goes from base to base.
family S1 := base | loop (i : I) [ ~i -> base, i -> base ]
-- The propositional truncation (S4b, R5 (a)): squash1 is a path between
-- any two points, so the squash1 fold case has the type isProp RES. A
-- field name is a core name (rule R4), so the names have a family prefix.
family Trunc1 (A : Type 0) := trunc1 (truncOf : A) | squash1 (squashFrom : Trunc1 A) (squashTo : Trunc1 A) (i : I) [ ~i -> squashFrom, i -> squashTo ]
-- The set truncation (S4c, R5 (a)): squash0 is a square between any two
-- paths with the same ends, so the squash0 fold case has the type isSet
-- RES (R8 (a)). The case binds the folded ends and the folded paths.
family Trunc0 (A : Type 0) := trunc0 (trunc0Of : A) | squash0 (squash0From : Trunc0 A) (squash0To : Trunc0 A) (squash0Left : Path (Trunc0 A) squash0From squash0To) (squash0Right : Path (Trunc0 A) squash0From squash0To) (i : I) (j : I) [ ~i -> squash0Left @ j, i -> squash0Right @ j, ~j -> squash0From, j -> squash0To ]
-- The set truncation at Type 1 (S6c item 9, ruling R8 (a) fallback): the
-- kit has no cumulativity and the Trunc0 parameter is in Type 0, so
-- Trunc0 (Rand T) refuses TYPE_MISMATCH. Trunc0One is Trunc0 with its
-- parameter in Type 1; its fold cases are the same.
family Trunc0One (A : Type 1) := trunc0One (trunc0OneOf : A) | squash0One (squash0OneFrom : Trunc0One A) (squash0OneTo : Trunc0One A) (squash0OneLeft : Path (Trunc0One A) squash0OneFrom squash0OneTo) (squash0OneRight : Path (Trunc0One A) squash0OneFrom squash0OneTo) (i : I) (j : I) [ ~i -> squash0OneLeft @ j, i -> squash0OneRight @ j, ~j -> squash0OneFrom, j -> squash0OneTo ]
-- The set quotient (S4c, R5 (a)): quotEq is a path from quot A R a to
-- quot A R b for each proof r of R a b. The type of the R parameter uses
-- the A parameter. quotSquash has the squash0 shape at Quot A R, so the
-- quotSquash fold case has the type isSet RES (R8 (a)).
family Quot (A : Type 0) (R : A -> A -> Type 0) := quot (quotOf : A)
  | quotEq (quotA : A) (quotB : A) (quotR : R quotA quotB) (i : I) [ ~i -> quot A R quotA, i -> quot A R quotB ]
  | quotSquash (quotFrom : Quot A R) (quotTo : Quot A R) (quotLeft : Path (Quot A R) quotFrom quotTo) (quotRight : Path (Quot A R) quotFrom quotTo) (i : I) (j : I)
    [ ~i -> quotLeft @ j, i -> quotRight @ j, ~j -> quotFrom, j -> quotTo ]

def lineTotal : (item : Item) -> Nat :=
  fun (item : Item) => natMul (itemPrice item) (itemCount item)
def isRed : (color : Color) -> Fin 2 :=
  fun (color : Color) => fold 1 0 0 color
def total : (items : List Item) -> Nat :=
  fun (items : List Item) => fold (fun (item : Item) (acc : Nat) => natAdd (lineTotal item) acc) 0 items
def redTotal : (items : List Item) -> Nat :=
  fun (items : List Item) => total (filter (fun (item : Item) => isRed (itemColor item)) items)
def depth : (s : Stack) -> Nat :=
  fun (s : Stack) => fold 0 (fun (top : Nat) (rest : Nat) => natAdd rest 1) s

-- Kan library (S2a, R6 (a)): transport, subst, J and the J rule as a path
-- (JRefl, O11), all by transp.
def transport : (X : Type 0) -> (Y : Type 0) -> Path (Type 0) X Y -> X -> Y :=
  fun (X : Type 0) => fun (Y : Type 0) => fun (p : Path (Type 0) X Y) => fun (a : X) => transp (fun (i : I) => p @ i) i0 a
def subst : (A : Type 0) -> (B : A -> Type 0) -> (x : A) -> (y : A) -> Path A x y -> B x -> B y :=
  fun (A : Type 0) => fun (B : A -> Type 0) => fun (x : A) => fun (y : A) => fun (p : Path A x y) => fun (b : B x) =>
    transp (fun (i : I) => B (p @ i)) i0 b
def J : (A : Type 0) -> (x : A) -> (P : (y : A) -> Path A x y -> Type 0) -> P x refl -> (y : A) -> (p : Path A x y) -> P y p :=
  fun (A : Type 0) => fun (x : A) => fun (P : (y : A) -> Path A x y -> Type 0) => fun (d : P x refl) => fun (y : A) => fun (p : Path A x y) =>
    transp (fun (i : I) => P (p @ i) (fun (j : I) => p @ (i /\ j))) i0 d
def JRefl : (A : Type 0) -> (x : A) -> (P : (y : A) -> Path A x y -> Type 0) -> (d : P x refl) -> Path (P x refl) (J A x P d x refl) d :=
  fun (A : Type 0) => fun (x : A) => fun (P : (y : A) -> Path A x y -> Type 0) => fun (d : P x refl) =>
    fun (i : I) => transp (fun (_ : I) => P x refl) i d
-- Path composition (S2b, R2 (a)): trans by hcomp, with the tube x on ~j
-- and q on j, and the base p.
def trans : (A : Type 0) -> (x : A) -> (y : A) -> (z : A) -> Path A x y -> Path A y z -> Path A x z :=
  fun (A : Type 0) => fun (x : A) => fun (y : A) => fun (z : A) => fun (p : Path A x y) => fun (q : Path A y z) =>
    fun (j : I) => hcomp A (~j \/ j) (fun (i : I) => [ ~j -> x, j -> q @ i ]) (p @ j)
-- Equivalences (S3a, R3 (a)): contractible types, fibers, isEquiv and
-- Equiv as Sigma types (the map, then for each y the center pack x p and
-- the contraction), idEquiv, and isoToEquiv as in agda/cubical
-- isoToIsEquiv. isoCap is the fill at k = i1; isoPath is the first part
-- of the fiber path. The squares are inline, with j flipped.
def isContr : (A : Type 0) -> Type 0 :=
  fun (A : Type 0) => Sigma (c : A) ((x : A) -> Path A c x)
-- Propositions and sets (S4b): the squash1 fold case has the type
-- isProp RES, the squash0 and quotSquash fold cases the type isSet RES.
def isProp : (A : Type 0) -> Type 0 :=
  fun (A : Type 0) => (x : A) -> (y : A) -> Path A x y
def isSet : (A : Type 0) -> Type 0 :=
  fun (A : Type 0) => (x : A) -> (y : A) -> isProp (Path A x y)
def fiber : (A : Type 0) -> (B : Type 0) -> (f : A -> B) -> (y : B) -> Type 0 :=
  fun (A : Type 0) => fun (B : Type 0) => fun (f : A -> B) => fun (y : B) => Sigma (x : A) (Path B (f x) y)
def isEquiv : (A : Type 0) -> (B : Type 0) -> (f : A -> B) -> Type 0 :=
  fun (A : Type 0) => fun (B : Type 0) => fun (f : A -> B) => (y : B) -> isContr (fiber A B f y)
def Equiv : (A : Type 0) -> (B : Type 0) -> Type 0 :=
  fun (A : Type 0) => fun (B : Type 0) => Sigma (f : A -> B) (isEquiv A B f)
def idEquiv : (A : Type 0) -> Equiv A A :=
  fun (A : Type 0) => pack (fun (x : A) => x) (fun (y : A) =>
    pack (pack y refl) (fun (z : fiber A A (fun (x : A) => x) y) =>
      fun (i : I) => pack (payload z @ ~i) (fun (j : I) => payload z @ (~i \/ j))))
def isoCap : (A : Type 0) -> (B : Type 0) -> (f : A -> B) -> (g : B -> A) -> (t : (x : A) -> Path A (g (f x)) x) ->
  (y : B) -> (x0 : A) -> (p0 : Path B (f x0) y) -> Path A (g y) x0 :=
  fun (A : Type 0) => fun (B : Type 0) => fun (f : A -> B) => fun (g : B -> A) => fun (t : (x : A) -> Path A (g (f x)) x) =>
  fun (y : B) => fun (x0 : A) => fun (p0 : Path B (f x0) y) =>
    fun (i : I) => hcomp A (i \/ ~i \/ ~i1) (fun (m : I) => [ i -> t x0 @ (i1 /\ m), ~i -> g y, ~i1 -> g (p0 @ ~i) ]) (g (p0 @ ~i))
def isoPath : (A : Type 0) -> (B : Type 0) -> (f : A -> B) -> (g : B -> A) -> (t : (x : A) -> Path A (g (f x)) x) ->
  (y : B) -> (x0 : A) -> (p0 : Path B (f x0) y) -> (x1 : A) -> (p1 : Path B (f x1) y) -> Path A x0 x1 :=
  fun (A : Type 0) => fun (B : Type 0) => fun (f : A -> B) => fun (g : B -> A) => fun (t : (x : A) -> Path A (g (f x)) x) =>
  fun (y : B) => fun (x0 : A) => fun (p0 : Path B (f x0) y) => fun (x1 : A) => fun (p1 : Path B (f x1) y) =>
    fun (i : I) => hcomp A (i \/ ~i \/ ~i1) (fun (m2 : I) => [ i -> isoCap A B f g t y x1 p1 @ (i1 /\ m2), ~i -> isoCap A B f g t y x0 p0 @ (i1 /\ m2), ~i1 -> g y ]) (g y)
def isoToEquiv : (A : Type 0) -> (B : Type 0) -> (f : A -> B) -> (g : B -> A) ->
  (s : (y : B) -> Path B (f (g y)) y) -> (t : (x : A) -> Path A (g (f x)) x) -> Equiv A B :=
  fun (A : Type 0) => fun (B : Type 0) => fun (f : A -> B) => fun (g : B -> A) =>
  fun (s : (y : B) -> Path B (f (g y)) y) => fun (t : (x : A) -> Path A (g (f x)) x) =>
  pack f (fun (y : B) => pack (pack (g y) (s y)) (fun (z : fiber A B f y) =>
    fun (i : I) => pack (isoPath A B f g t y (g y) (s y) (witness z) (payload z) @ i) (fun (j : I) =>
      hcomp B (i \/ ~i \/ ~j \/ j) (fun (m4 : I) => [
        i -> s (payload z @ j) @ m4,
        ~i -> s (s y @ j) @ m4,
        ~j -> s (f (isoPath A B f g t y (g y) (s y) (witness z) (payload z) @ i)) @ m4,
        j -> s y @ m4 ])
      (f (hcomp A (i \/ ~i \/ ~j \/ j) (fun (m3 : I) => [
        i -> hcomp A (~j \/ j \/ m3) (fun (m : I) => [ ~j -> t (witness z) @ (~m3 /\ m), j -> g y, m3 -> g (payload z @ j) ]) (g (payload z @ j)),
        ~i -> hcomp A (~j \/ j \/ m3) (fun (m : I) => [ ~j -> t (g y) @ (~m3 /\ m), j -> g y, m3 -> g (s y @ j) ]) (g (s y @ j)),
        ~j -> t (isoPath A B f g t y (g y) (s y) (witness z) (payload z) @ i) @ ~m3,
        j -> g y ])
        (hcomp A (i \/ ~i \/ j) (fun (m2 : I) => [
          i -> isoCap A B f g t y (witness z) (payload z) @ (~j /\ m2),
          ~i -> isoCap A B f g t y (g y) (s y) @ (~j /\ m2),
          j -> g y ]) (g y)))))))

-- ua (S3b): the Glue line from A to B. At i0 the type is A through e; at
-- i1 the type is B through idEquiv B. Transport along ua e at a closed
-- value of A gives witness e of the value (uaBeta).
def ua : (A : Type 0) -> (B : Type 0) -> (e : Equiv A B) -> Path (Type 0) A B :=
  fun (A : Type 0) => fun (B : Type 0) => fun (e : Equiv A B) =>
    fun (i : I) => Glue B (~i \/ i) (fun (_ : I) => [ ~i -> pack A e, i -> pack B (idEquiv B) ])
-- uaArrow (S3c): agda/cubical ua-> with a constant C. A path h a from
-- f0 a to f1 (witness e a) for each a gives a path of functions over ua e
-- from f0 to f1. At i0 the hcomp is its ~i tube at j = i1, h a @ i0 =
-- f0 a; at i1 it is its i tube, f1 a. The base is f1 (unglue a).
def uaArrow : (A : Type 0) -> (B : Type 0) -> (C : Type 0) -> (e : Equiv A B) -> (f0 : A -> C) -> (f1 : B -> C) ->
  (h : (a : A) -> Path C (f0 a) (f1 (witness e a))) -> PathP (fun (i : I) => (ua A B e @ i) -> C) f0 f1 :=
  fun (A : Type 0) => fun (B : Type 0) => fun (C : Type 0) => fun (e : Equiv A B) => fun (f0 : A -> C) => fun (f1 : B -> C) =>
  fun (h : (a : A) -> Path C (f0 a) (f1 (witness e a))) =>
    fun (i : I) => fun (a : ua A B e @ i) => hcomp C (~i \/ i) (fun (j : I) => [ ~i -> h a @ ~j, i -> f1 a ]) (f1 (unglue a))

-- Fin subtraction (S5a, R3 (a)): a - b mod n as a plus the negation of b.
def finSub : (n : Nat) -> Fin n -> Fin n -> Fin n :=
  fun (n : Nat) (a b : Fin n) => finAdd n a (finNeg n b)

-- Decidability (S5b, R3 (a)): Empty is Fin 0 and absurd is its empty case.
-- Not A is a map into Empty. Dec A holds a proof or a refutation. Stable A
-- turns a double negation into a proof; decStable gives it by either.
-- isPropNot: two maps into Empty are equal by funExt, since each value of
-- Empty is absurd.
def Empty : Type 0 := Fin 0
def absurd : (A : Type 0) -> Empty -> A := fun (A : Type 0) (k : Fin 0) => finCase 0 k
def Not : Type 0 -> Type 0 := fun (A : Type 0) => A -> Empty
def Dec : Type 0 -> Type 0 := fun (A : Type 0) => Sum A (Not A)
def Stable : Type 0 -> Type 0 := fun (A : Type 0) => Not (Not A) -> A
def decStable : (A : Type 0) -> Dec A -> Stable A :=
  fun (A : Type 0) (d : Dec A) (nn : Not (Not A)) => either (fun (a : A) => a) (fun (na : Not A) => absurd A (nn na)) d
def isPropNot : (A : Type 0) -> isProp (Not A) :=
  fun (A : Type 0) (f g : Not A) => funExt (fun (a : A) => absurd (Path Empty (f a) (g a)) (f a))

-- Hedberg (S5b, R4 (a)): a type with decidable equality is a set, by the
-- agda/cubical Stable route. hedbergStable: each path type from a is
-- stable, by decStable. hedbergMap: the stable map on Path A a x.
-- hedbergConst: the map is constant, since isPropNot equates the two
-- double negations. hedbergSquare: the map over a path p, a PathP from the
-- map at refl to the map at p. hedberg: one hcomp with four faces, each a
-- at k = i0; the lid is the square with the sides p, q and the ends a, b.
-- isSetNat and isSetFin are the two instances.
def hedbergStable : (A : Type 0) -> ((a : A) -> (b : A) -> Dec (Path A a b)) -> (a : A) -> (x : A) -> Stable (Path A a x) :=
  fun (A : Type 0) (dec : (a : A) -> (b : A) -> Dec (Path A a b)) (a : A) (x : A) => decStable (Path A a x) (dec a x)
def hedbergMap : (A : Type 0) -> ((a : A) -> (b : A) -> Dec (Path A a b)) -> (a : A) -> (x : A) -> Path A a x -> Path A a x :=
  fun (A : Type 0) (dec : (a : A) -> (b : A) -> Dec (Path A a b)) (a : A) (x : A) (p : Path A a x) => hedbergStable A dec a x (fun (h : Not (Path A a x)) => h p)
def hedbergConst : (A : Type 0) -> (dec : (a : A) -> (b : A) -> Dec (Path A a b)) -> (a : A) -> (x : A) -> (p : Path A a x) -> (q : Path A a x) -> Path (Path A a x) (hedbergMap A dec a x p) (hedbergMap A dec a x q) :=
  fun (A : Type 0) (dec : (a : A) -> (b : A) -> Dec (Path A a b)) (a : A) (x : A) (p : Path A a x) (q : Path A a x) => fun (k : I) => hedbergStable A dec a x (isPropNot (Not (Path A a x)) (fun (h : Not (Path A a x)) => h p) (fun (h : Not (Path A a x)) => h q) @ k)
def hedbergSquare : (A : Type 0) -> (dec : (a : A) -> (b : A) -> Dec (Path A a b)) -> (a : A) -> (b : A) -> (p : Path A a b) -> PathP (fun (j : I) => Path A a (p @ j)) (hedbergMap A dec a a (fun (_ : I) => a)) (hedbergMap A dec a b p) :=
  fun (A : Type 0) (dec : (a : A) -> (b : A) -> Dec (Path A a b)) (a : A) (b : A) (p : Path A a b) => fun (j : I) => hedbergMap A dec a (p @ j) (fun (i : I) => p @ (i /\ j))
def hedberg : (A : Type 0) -> ((a : A) -> (b : A) -> Dec (Path A a b)) -> isSet A :=
  fun (A : Type 0) (dec : (a : A) -> (b : A) -> Dec (Path A a b)) (a : A) (b : A) (p : Path A a b) (q : Path A a b) => fun (j : I) => fun (i : I) =>
    hcomp A (~i \/ i \/ ~j \/ j) (fun (k : I) => [
      ~i -> hedbergMap A dec a a (fun (_ : I) => a) @ k,
      i -> hedbergConst A dec a b p q @ j @ k,
      ~j -> hedbergSquare A dec a b p @ i @ k,
      j -> hedbergSquare A dec a b q @ i @ k ]) a
def isSetNat : isSet Nat := hedberg Nat decEqNat
def isSetFin : (n : Nat) -> isSet (Fin n) := fun (n : Nat) => hedberg (Fin n) (decEqFin n)
-- Decidable equality of pairs (S6c item 8, ruling R11 (a)). decEqProd
-- decides the first components, then the second ones. Each inr case maps
-- a path of pairs to a path of one component (a projection along the
-- path). decEqSigmaFin is decEqProd at Fin a and Fin b: the second
-- component of Sigma (e : Fin a) (Fin b) does not depend on e.
def decEqProd : (A : Type 0) -> (B : Type 0) -> ((a : A) -> (b : A) -> Dec (Path A a b)) -> ((a : B) -> (b : B) -> Dec (Path B a b)) -> (x : (e : A) * B) -> (y : (e : A) * B) -> Dec (Path ((e : A) * B) x y) :=
  fun (A : Type 0) (B : Type 0) (da : (a : A) -> (b : A) -> Dec (Path A a b)) (db : (a : B) -> (b : B) -> Dec (Path B a b)) (x : (e : A) * B) (y : (e : A) * B) =>
    either (fun (p : Path A (witness x) (witness y)) => either (fun (q : Path B (payload x) (payload y)) => inl (fun (i : I) => pack (p @ i) (q @ i))) (fun (nq : Not (Path B (payload x) (payload y))) => inr (fun (r : Path ((e : A) * B) x y) => nq (fun (i : I) => payload (r @ i)))) (db (payload x) (payload y))) (fun (np : Not (Path A (witness x) (witness y))) => inr (fun (r : Path ((e : A) * B) x y) => np (fun (i : I) => witness (r @ i)))) (da (witness x) (witness y))
def decEqSigmaFin : (a : Nat) -> (b : Nat) -> (x : (e : Fin a) * Fin b) -> (y : (e : Fin a) * Fin b) -> Dec (Path ((e : Fin a) * Fin b) x y) :=
  fun (a : Nat) (b : Nat) => decEqProd (Fin a) (Fin b) (decEqFin a) (decEqFin b)
-- Finite sets (S5c item 10, ruling R6 (a)): isFinSet A holds the size n
-- outside the truncation, as in agda/cubical, so card is a projection.
-- FinSet is in Type 1 (Type 0 : Type 1, no cumulativity). El is the
-- carrier, card the size, finSetFin the FinSet of Fin n by idEquiv.
def isFinSet : (A : Type 0) -> Type 0 :=
  fun (A : Type 0) => Sigma (n : Nat) (Trunc1 (Equiv A (Fin n)))
def FinSet : Type 1 := Sigma (A : Type 0) (isFinSet A)
def El : (X : FinSet) -> Type 0 := fun (X : FinSet) => witness X
def card : (X : FinSet) -> Nat := fun (X : FinSet) => witness (payload X)
def finSetFin : (n : Nat) -> FinSet :=
  fun (n : Nat) => pack (Fin n) (pack n (trunc1 (Equiv (Fin n) (Fin n)) (idEquiv (Fin n))))
-- Random variables (S6a item 2, rulings R1 and R2 (a)). A Rand T is a pack
-- of a finite coin space and a map from its points to T. Rand is in
-- Type 1 because FinSet is in Type 1. The kit builtins pure, map and bind
-- keep their names, so the monad operations are randPure and randMap.
def Rand : (T : Type 0) -> Type 1 := fun (T : Type 0) => Sigma (Om : FinSet) (El Om -> T)
def randPure : (T : Type 0) -> T -> Rand T := fun (T : Type 0) (x : T) => pack (finSetFin 1) (fun (w : Fin 1) => x)
def randMap : (A : Type 0) -> (B : Type 0) -> (A -> B) -> Rand A -> Rand B :=
  fun (A : Type 0) (B : Type 0) (f : A -> B) (r : Rand A) => pack (witness r) (fun (w : El (witness r)) => f (payload r w))
-- Bind (S6b item 7, ruling R3 (a)). The coin space of randBind r k is the
-- Sigma of the coins w of r and the coins of k at the value of r at w.
-- The kit has no general proof that this Sigma is a finite set, so the
-- caller gives the isFinSet proof (at literal carriers by finAll, as
-- prodFinSet in finset.lang).
def randBind : (A : Type 0) -> (B : Type 0) -> (r : Rand A) -> (k : A -> Rand B) -> isFinSet ((w : El (witness r)) * El (witness (k (payload r w)))) -> Rand B :=
  fun (A : Type 0) (B : Type 0) (r : Rand A) (k : A -> Rand B) (fs : isFinSet ((w : El (witness r)) * El (witness (k (payload r w))))) =>
    pack (pack ((w : El (witness r)) * El (witness (k (payload r w)))) fs) (fun (p : (w : El (witness r)) * El (witness (k (payload r w)))) => payload (k (payload r (witness p))) (payload p))
-- Couplings (S6b item 5, rulings R5 and R6 (a)). An equivalence s of the
-- coin spaces and a path h from f w to g (witness s w) at each point w
-- give a path in Rand T. The carrier part is ua of s and the map part is
-- uaArrow of h. The size part is the size path n: the kit has no
-- pigeonhole, so couple takes n (refl at equal literal sizes). The
-- truncation part is squash1 of two transp, as sqOver in finset.lang.
def couple : (T : Type 0) -> (Om : FinSet) -> (Om2 : FinSet) -> (f : El Om -> T) -> (g : El Om2 -> T) -> (s : Equiv (El Om) (El Om2)) ->
  (h : (w : El Om) -> Path T (f w) (g (witness s w))) -> (n : Path Nat (card Om) (card Om2)) -> Path (Rand T) (pack Om f) (pack Om2 g) :=
  fun (T : Type 0) (Om : FinSet) (Om2 : FinSet) (f : El Om -> T) (g : El Om2 -> T) (s : Equiv (El Om) (El Om2)) =>
  fun (h : (w : El Om) -> Path T (f w) (g (witness s w))) (n : Path Nat (card Om) (card Om2)) =>
    fun (i : I) => pack (pack (ua (El Om) (El Om2) s @ i) (pack (n @ i)
      (squash1 (Equiv (ua (El Om) (El Om2) s @ i) (Fin (n @ i)))
        (transp (fun (j : I) => Trunc1 (Equiv (ua (El Om) (El Om2) s @ (i /\ j)) (Fin (n @ (i /\ j))))) (~i) (payload (payload Om)))
        (transp (fun (j : I) => Trunc1 (Equiv (ua (El Om) (El Om2) s @ (i \/ ~j)) (Fin (n @ (i \/ ~j))))) i (payload (payload Om2)))
        i)))
      (uaArrow (El Om) (El Om2) T s f g h @ i)
-- Counts (S6c item 9, rulings R8 and R9 (a)). randCount T dec r t is the
-- number of coins of r whose value is t: the carrierSum of 1 where dec
-- gives a path and 0 where it does not. examples/formers.lang declares a
-- def count, and a domain def is a core name, so this def is randCount.
-- Bag T is Trunc0One (Rand T): Rand T is in Type 1 and the Trunc0
-- parameter is in Type 0. countBag reads a count through the truncation
-- by a fold into Nat with isSetNat. countCouple is the direction from a
-- coupling to equal counts: the path of randCount along a path in Rand T.
def randCount : (T : Type 0) -> ((a : T) -> (b : T) -> Dec (Path T a b)) -> Rand T -> T -> Nat :=
  fun (T : Type 0) (dec : (a : T) -> (b : T) -> Dec (Path T a b)) (r : Rand T) (t : T) => carrierSum (El (witness r)) (fun (w : El (witness r)) => either (fun (_ : Path T (payload r w) t) => 1) (fun (_ : Not (Path T (payload r w) t)) => 0) (dec (payload r w) t))
def Bag : (T : Type 0) -> Type 1 := fun (T : Type 0) => Trunc0One (Rand T)
def countBag : (T : Type 0) -> ((a : T) -> (b : T) -> Dec (Path T a b)) -> Bag T -> T -> Nat :=
  fun (T : Type 0) (dec : (a : T) -> (b : T) -> Dec (Path T a b)) (b : Bag T) (t : T) => fold (fun (r : Rand T) => randCount T dec r t) isSetNat b
def countCouple : (T : Type 0) -> (dec : (a : T) -> (b : T) -> Dec (Path T a b)) -> (x : Rand T) -> (y : Rand T) -> Path (Rand T) x y -> (t : T) -> Path Nat (randCount T dec x t) (randCount T dec y t) :=
  fun (T : Type 0) (dec : (a : T) -> (b : T) -> Dec (Path T a b)) (x : Rand T) (y : Rand T) (p : Path (Rand T) x y) (t : T) => fun (i : I) => randCount T dec (p @ i) t
-- Match (S6c item 10, ruling R10 (a)). fiberEq T dec a b is 1 when dec
-- gives a path and 0 when it does not. fiberAt sends a coin x of Om to the
-- coin of Om2 with the same rank in the fiber of f x: the builtin
-- fiberMatch. Its fallback map is used if that rank has no target coin.
-- Requiring that map prevents a failed search from inhabiting Empty.
-- match is the direction from equal counts to a coupling: the
-- two fiberAt maps, their inverse laws s and r, the value law h and the
-- size path n give a couple. When the counts are not equal, a law does
-- not check at the literal instance.
def fiberEq : (T : Type 0) -> ((a : T) -> (b : T) -> Dec (Path T a b)) -> T -> T -> Fin 2 :=
  fun (T : Type 0) (dec : (a : T) -> (b : T) -> Dec (Path T a b)) (a : T) (b : T) => either (fun (_ : Path T a b) => 1) (fun (_ : Not (Path T a b)) => 0) (dec a b)
def fiberAt : (T : Type 0) -> (dec : (a : T) -> (b : T) -> Dec (Path T a b)) -> (Om : FinSet) -> (Om2 : FinSet) -> (f : El Om -> T) -> (g : El Om2 -> T) -> (El Om -> El Om2) -> El Om -> El Om2 :=
  fun (T : Type 0) (dec : (a : T) -> (b : T) -> Dec (Path T a b)) (Om : FinSet) (Om2 : FinSet) (f : El Om -> T) (g : El Om2 -> T) (fallback : El Om -> El Om2) (x : El Om) => fiberMatch (El Om) (El Om2) T (fiberEq T dec) f g fallback x
def match : (T : Type 0) -> (dec : (a : T) -> (b : T) -> Dec (Path T a b)) -> (Om : FinSet) -> (Om2 : FinSet) -> (f : El Om -> T) -> (g : El Om2 -> T) ->
  (forwardDefault : El Om -> El Om2) -> (backwardDefault : El Om2 -> El Om) ->
  (s : (y : El Om2) -> Path (El Om2) (fiberAt T dec Om Om2 f g forwardDefault (fiberAt T dec Om2 Om g f backwardDefault y)) y) ->
  (r : (x : El Om) -> Path (El Om) (fiberAt T dec Om2 Om g f backwardDefault (fiberAt T dec Om Om2 f g forwardDefault x)) x) ->
  (h : (w : El Om) -> Path T (f w) (g (fiberAt T dec Om Om2 f g forwardDefault w))) -> (n : Path Nat (card Om) (card Om2)) -> Path (Rand T) (pack Om f) (pack Om2 g) :=
  fun (T : Type 0) (dec : (a : T) -> (b : T) -> Dec (Path T a b)) (Om : FinSet) (Om2 : FinSet) (f : El Om -> T) (g : El Om2 -> T) =>
  fun (forwardDefault : El Om -> El Om2) (backwardDefault : El Om2 -> El Om) =>
  fun (s : (y : El Om2) -> Path (El Om2) (fiberAt T dec Om Om2 f g forwardDefault (fiberAt T dec Om2 Om g f backwardDefault y)) y) =>
  fun (r : (x : El Om) -> Path (El Om) (fiberAt T dec Om2 Om g f backwardDefault (fiberAt T dec Om Om2 f g forwardDefault x)) x) =>
  fun (h : (w : El Om) -> Path T (f w) (g (fiberAt T dec Om Om2 f g forwardDefault w))) (n : Path Nat (card Om) (card Om2)) =>
    couple T Om Om2 f g (isoToEquiv (El Om) (El Om2) (fiberAt T dec Om Om2 f g forwardDefault) (fiberAt T dec Om2 Om g f backwardDefault) s r) h n
