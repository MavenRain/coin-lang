-- Entries: first-order Nat and Fin 2 definitions. The target exports them.
def addPrice : (a : Nat) -> (b : Nat) -> Nat := fun (a : Nat) (b : Nat) => natAdd a b
def scale : (a k : Nat) -> Nat := fun (a k : Nat) => natMul a k
def discount : (a d : Nat) -> Nat := fun (a d : Nat) => natSub a d
def cheap : (a : Nat) -> Fin 2 := fun (a : Nat) => natLe a 100
def square : (n : Nat) -> Nat := fun (n : Nat) => fold (fun (acc : Nat) => natAdd acc n) 0 n
def pick : (f : Fin 2) -> (a b : Nat) -> Nat := fun (f : Fin 2) (a b : Nat) => finCase 2 f b a
